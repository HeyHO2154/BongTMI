//지정된 객체의 문자열의 길이를 계산하는 부분
//-------------------------------------------------------------------

function CheckByte(str){

    var i;
    var strLen;
    var strByte;

    strLen = str.length;

    // IE4.0 이상

    if(IEYES == 1){
        for(i=0, strByte=0;i<strLen;i++){
            if(str.charAt(i) >= ' ' && str.charAt(i) <= '~' ) strByte++;
            else strByte += 2;
        }
        return strByte;
    // Netscape일 경우
    }else{
        return strLen;
    }
}

