/*
 * 해당필드에 숫자만 입력
 * 사용예: onkeydown="return onlyNumber(event);" 
 */
function onlyNumber(event) {
	event = event || window.event;
	var keyID = (event.which) ? event.which : event.keyCode;
	if( ( keyID >=48 && keyID <= 57 ) || ( keyID >=96 && keyID <= 105 ) ){
		return;
	}else{
		return false;
	}
}

